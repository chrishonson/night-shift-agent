{
  "version": 1,
  "gates": [
    {
      "id": "worker_tests",
      "placement": [
        "local"
      ],
      "commands": [
        ".venv/bin/python -m pytest -q parts_tests --cov=agent_night_shift --cov=context_capture --cov=run_record --cov-fail-under=55"
      ]
    },
    {
      "id": "worker_syntax",
      "placement": [
        "local"
      ],
      "commands": [
        ".venv/bin/python -m py_compile agent_night_shift.py context_capture.py run_record.py scripts/run-record.py"
      ]
    },
    {
      "id": "nightshift_quality",
      "placement": [
        "local"
      ],
      "commands": [
        ".venv/bin/python -m pytest parts_tests -q"
      ]
    }
  ]
}
