# Night Shift Agent Configuration
# Copy this file to .env and fill in your values.

# --- Identity and credentials -------------------------------------------
# Needs: Contents (read/write), Pull requests (read/write), Metadata (read),
# Actions (read)
GH_BOT_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BOT_USERNAME=agentnightshift
BOT_EMAIL=agentnightshift@gmail.com

# --- Provider selection -------------------------------------------------
# A provider is categorised by how the agent reaches the model, because that
# is what decides auth, cost and failure mode:
#
#   headless  a coding CLI driven in print mode, paid by subscription
#   local     inference on this machine, paid in electricity
#   cloud     an HTTP API billed per token. Built, deliberately not wired.
#
# The chain is always headless first, local underneath it as the fallback.
# By default it is Antigravity, then straight to local.
#
#   FORCE_PROVIDER unset                        antigravity, then local
#   FORCE_PROVIDER=antigravity|claude|gemini    pin the headless lead
#   FORCE_PROVIDER=ollama                       local only, works offline
#
# An unrecognised value logs a warning and uses the default chain.
# FORCE_PROVIDER=

# --- headless -----------------------------------------------------------
# Pin these. Left unset, a CLI silently follows its account default and the
# model behind your agent can change without a commit.
#
# Antigravity leads the default chain. `agy models` lists the valid ids.
# The -low tier could not complete a Compose UI card. -high can.
ANTIGRAVITY_MODEL=gemini-3.8-flash-high
# Reachable with FORCE_PROVIDER=claude, not in the default walk.
CLAUDE_MODEL=claude-sonnet-5
# The standalone Gemini CLI. Its oauth-personal tier was retired by Google,
# so this cannot authenticate. Antigravity is the replacement.
GEMINI_MODEL=gemini-3-flash-preview

# --- local --------------------------------------------------------------
# Must already be pulled: `ollama list`. This is the fallback the whole chain
# rests on, so a model id that is not present makes the fallback fictional.
OLLAMA_MODEL=qwen3.8:27b

# --- cloud (not wired) --------------------------------------------------
# Nothing in the chain selects these. Setting them has no effect until a cloud
# provider is wired back into ProviderManager._init_providers. Verify any model
# id against https://openrouter.ai/api/v1/models before trusting it.
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=mistralai/devstral-2512

# --- Misc ---------------------------------------------------------------
# Used when no --project-dir argument is given.
DEFAULT_TARGET_PROJECT=/path/to/your/target/project
